{
  "name": "dip-bundestag-workspace",
  "private": true,
  "description": "Workspace of @maschinenlesbar.org/dip-bundestag-cli: the CLI in apps/cli, the API client in packages/client.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "clean": "node -e \"const {rmSync,readdirSync}=require('fs');for(const d of ['apps','packages'])for(const p of readdirSync(d))rmSync(d+'/'+p+'/dist',{recursive:true,force:true})\"",
    "build": "tsc -b tsconfig.json tsconfig.test.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "pretest": "npm run build",
    "test": "npm test --workspaces --if-present",
    "coverage": "node --test $(node -p \"+process.versions.node.split('.')[0] >= 24 ? '--test-timeout=5000' : ''\") --experimental-test-coverage --test-coverage-exclude=\"**/test/**\" apps/*/dist/test/*.test.js packages/*/dist/test/*.test.js",
    "docs": "node tools/docs/node_modules/typedoc/bin/typedoc apps/cli/src/index.ts --tsconfig tsconfig.docs.json --name @maschinenlesbar.org/dip-bundestag-cli --out out",
    "start": "node apps/cli/dist/src/cli/index.js",
    "pack": "npm pack -w apps/cli",
    "bump": "node tools/bump.mjs",
    "preversion": "echo \"The root has no version. Bump the app: npm run bump -- <patch|minor|major>\" >&2 && exit 1",
    "obtain-key": "node apps/cli/dist/src/cli/index.js obtain-key"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2"
  }
}
